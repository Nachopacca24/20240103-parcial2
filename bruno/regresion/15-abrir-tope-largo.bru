meta {
  name: Abrir ticket para tope largo
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/tickets
  body: json
  auth: none
}

body:json {
  {
    "placa": "P321XYZ",
    "entrada": "2026-10-22T08:00:00"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("topeLargoId", res.body.id);
}

docs {
  Tecnica: Preparacion del caso de tope (particion de equivalencia)
  Valor probado: POST de P321XYZ con entrada 08:00
  Resultado esperado: 201 Created; se guarda topeLargoId
}
